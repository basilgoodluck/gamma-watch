# --- Alpaca (paper trading only - see the hard safety check in agent/config.py) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Symbols ---
WATCHLIST_SYMBOLS=SPY,QQQ,AAPL,TSLA,NVDA,MSFT,AMZN,META,GOOGL,AMD
UNDERLYING_SYMBOL=SPY
ZERO_DTE_SYMBOLS=SPY,QQQ,IWM

RISK_FREE_RATE=0.045
FEATHERLESS_API_KEY=

# --- Neon Postgres connection string. Required - the app raises on startup ---
# --- without it. Run db/schema.sql once against a fresh database first.    ---
DATABASE_URL=

# --- Comma-separated Vercel origin(s), e.g. https://your-app.vercel.app ---
# --- Local dev doesn't need this - http://localhost:<port> is always allowed. ---
FRONTEND_ORIGIN=

# --- Set automatically by Railway - do not set manually in Railway. ---
# PORT=8000
